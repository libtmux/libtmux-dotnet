<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>LibTmux.Generators</AssemblyName>
    <RootNamespace>LibTmux.Generators</RootNamespace>
    <IsPackable>false</IsPackable>

    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Roslyn loads analyzers on the compiler's own runtime, which is why this
         one project targets netstandard2.0 and cannot use the repo's implicit
         usings or nullable reference types the way the library does. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>
</Project>
