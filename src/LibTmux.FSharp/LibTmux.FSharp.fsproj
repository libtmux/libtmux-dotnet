<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>LibTmux.FSharp</AssemblyName>
    <RootNamespace>LibTmux.FSharp</RootNamespace>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>LibTmux.FSharp</PackageId>
    <Description>F# task functions and pure snapshot queries over LibTmux handles.</Description>
    <PackageTags>tmux;fsharp;terminal;automation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Library.fsi" />
    <Compile Include="Library.fs" />
    <Compile Include="Query.fsi" />
    <Compile Include="Query.fs" />
    <ProjectReference Include="../LibTmux/LibTmux.csproj" />
    <PackageReference Include="FSharp.Core" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="PinCorePackageDependency" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)"
                                      Condition="'%(_ProjectReferencesWithVersions.Filename)' == 'LibTmux'">
        <ProjectVersion>[$(PackageVersion)]</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>
</Project>
