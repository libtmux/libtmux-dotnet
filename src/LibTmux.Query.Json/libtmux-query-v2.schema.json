    "sessionIdOrNullConstantNode": {"oneOf": [{"$ref": "#/$defs/sessionIdConstantNode"}, {"$ref": "#/$defs/nullConstantNode"}]},
    "windowIdOrNullConstantNode": {"oneOf": [{"$ref": "#/$defs/windowIdConstantNode"}, {"$ref": "#/$defs/nullConstantNode"}]},
    "paneIdOrNullConstantNode": {"oneOf": [{"$ref": "#/$defs/paneIdConstantNode"}, {"$ref": "#/$defs/nullConstantNode"}]},
    "clientIdOrNullConstantNode": {"oneOf": [{"$ref": "#/$defs/clientIdConstantNode"}, {"$ref": "#/$defs/nullConstantNode"}]},
