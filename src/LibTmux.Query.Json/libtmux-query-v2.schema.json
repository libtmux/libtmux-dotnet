{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libtmux.git-pull.com/schema/libtmux-query-v2.schema.json",
  "title": "libtmux query document v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "target", "predicate"],
  "properties": {
    "schema": {"const": "libtmux-query"},
    "version": {"const": 2},
    "target": {"$ref": "#/$defs/target"},
    "predicate": {"$ref": "#/$defs/node"}
  },
  "oneOf": [
    {
      "properties": {"target": {"const": "session"}, "predicate": {"$ref": "#/$defs/sessionNode"}}
    },
    {"properties": {"target": {"const": "window"}, "predicate": {"$ref": "#/$defs/windowNode"}}},
    {"properties": {"target": {"const": "pane"}, "predicate": {"$ref": "#/$defs/paneNode"}}},
    {"properties": {"target": {"const": "client"}, "predicate": {"$ref": "#/$defs/clientNode"}}}
  ],
  "$defs": {
    "target": {"enum": ["session", "window", "pane", "client"]},
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "wireName"],
      "properties": {
        "kind": {"const": "field"},
        "target": {"$ref": "#/$defs/target"},
        "wireName": {
          "enum": [
            "client_control_mode",
            "client_id",
            "client_name",
            "pane_command",
            "pane_current_path",
            "pane_id",
            "pane_session",
            "pane_window",
            "session_active_pane",
            "session_active_window",
            "session_attached",
            "session_id",
            "session_name",
            "session_panes",
            "session_windows",
            "window_active",
            "window_active_pane",
            "window_id",
            "window_index",
            "window_linked_sessions",
            "window_name",
            "window_panes",
            "window_session"
          ]
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "target": {"const": "session"},
                "wireName": {
                  "enum": [
                    "session_active_pane",
                    "session_active_window",
                    "session_attached",
                    "session_id",
                    "session_name",
                    "session_panes",
                    "session_windows"
                  ]
                }
              }
            },
            {
              "properties": {
                "target": {"const": "window"},
                "wireName": {
                  "enum": [
                    "window_active",
                    "window_active_pane",
                    "window_id",
                    "window_index",
                    "window_linked_sessions",
                    "window_name",
                    "window_panes",
                    "window_session"
                  ]
                }
              }
            },
            {
              "properties": {
                "target": {"const": "pane"},
                "wireName": {
                  "enum": [
                    "pane_command",
                    "pane_current_path",
                    "pane_id",
                    "pane_session",
                    "pane_window"
                  ]
                }
              }
            },
            {
              "properties": {
                "target": {"const": "client"},
                "wireName": {"enum": ["client_control_mode", "client_id", "client_name"]}
              }
            }
          ]
        }
      ]
    },
    "booleanField": {
      "allOf": [
        {"$ref": "#/$defs/field"},
        {
          "properties": {"wireName": {"enum": ["client_control_mode", "session_attached", "window_active"]}}
        }
      ]
    },
    "stringField": {
      "allOf": [
        {"$ref": "#/$defs/field"},
        {
          "properties": {
            "wireName": {
              "enum": [
                "client_name",
                "pane_command",
                "pane_current_path",
                "session_name",
                "window_name"
              ]
            }
          }
        }
      ]
    },
    "int64Field": {
      "allOf": [
        {"$ref": "#/$defs/field"},
        {
          "properties": {
            "wireName": {
              "enum": [
                "session_panes",
                "session_windows",
                "window_index",
                "window_linked_sessions",
                "window_panes"
              ]
            }
          }
        }
      ]
    },
    "relationField": {
      "allOf": [
        {"$ref": "#/$defs/field"},
        {
          "properties": {
            "wireName": {
              "enum": [
                "pane_session",
                "pane_window",
                "session_active_pane",
                "session_active_window",
                "session_panes",
                "session_windows",
                "window_active_pane",
                "window_linked_sessions",
                "window_panes",
                "window_session"
              ]
            }
          }
        }
      ]
    },
    "sessionIdField": {
      "allOf": [{"$ref": "#/$defs/field"}, {"properties": {"wireName": {"const": "session_id"}}}]
    },
    "windowIdField": {"allOf": [{"$ref": "#/$defs/field"}, {"properties": {"wireName": {"const": "window_id"}}}]},
    "paneIdField": {"allOf": [{"$ref": "#/$defs/field"}, {"properties": {"wireName": {"const": "pane_id"}}}]},
    "clientIdField": {"allOf": [{"$ref": "#/$defs/field"}, {"properties": {"wireName": {"const": "client_id"}}}]},
    "sessionField": {"allOf": [{"$ref": "#/$defs/field"}, {"properties": {"target": {"const": "session"}}}]},
    "windowField": {"allOf": [{"$ref": "#/$defs/field"}, {"properties": {"target": {"const": "window"}}}]},
    "paneField": {"allOf": [{"$ref": "#/$defs/field"}, {"properties": {"target": {"const": "pane"}}}]},
    "clientField": {"allOf": [{"$ref": "#/$defs/field"}, {"properties": {"target": {"const": "client"}}}]},
    "sessionBooleanField": {"allOf": [{"$ref": "#/$defs/booleanField"}, {"$ref": "#/$defs/sessionField"}]},
    "clientBooleanField": {"allOf": [{"$ref": "#/$defs/booleanField"}, {"$ref": "#/$defs/clientField"}]},
    "sessionRelationField": {"allOf": [{"$ref": "#/$defs/collectionRelationField"}, {"$ref": "#/$defs/sessionField"}]},
    "windowRelationField": {"allOf": [{"$ref": "#/$defs/collectionRelationField"}, {"$ref": "#/$defs/windowField"}]},
    "nullConstant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {"kind": {"const": "null"}}
    },
    "booleanConstant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {"kind": {"const": "boolean"}, "value": {"type": "boolean"}}
    },
    "int64Constant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"const": "int64"},
        "value": {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807}
      }
    },
    "stringConstant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"const": "string"},
        "value": {"type": "string", "maxLength": 4096, "pattern": "^[^\\uD800-\\uDFFF]*$"}
      }
    },
    "typedIdConstant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "type", "value"],
      "properties": {
        "kind": {"const": "typedId"},
        "type": {"enum": ["session", "window", "pane", "client"]},
        "value": {"type": "string", "maxLength": 4096, "pattern": "^[^\\uD800-\\uDFFF]*$"}
      }
    },
    "constant": {
      "oneOf": [
        {"$ref": "#/$defs/nullConstant"},
        {"$ref": "#/$defs/booleanConstant"},
        {"$ref": "#/$defs/int64Constant"},
        {"$ref": "#/$defs/stringConstant"},
        {"$ref": "#/$defs/typedIdConstant"}
      ]
    },
    "constantNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {"kind": {"const": "constant"}, "value": {"$ref": "#/$defs/constant"}}
    },
    "nullConstantNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {"kind": {"const": "constant"}, "value": {"$ref": "#/$defs/nullConstant"}}
    },
    "booleanConstantNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {"kind": {"const": "constant"}, "value": {"$ref": "#/$defs/booleanConstant"}}
    },
    "int64ConstantNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {"kind": {"const": "constant"}, "value": {"$ref": "#/$defs/int64Constant"}}
    },
    "stringConstantNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {"kind": {"const": "constant"}, "value": {"$ref": "#/$defs/stringConstant"}}
    },
    "booleanOrNullConstantNode": {"oneOf": [{"$ref": "#/$defs/booleanConstantNode"}, {"$ref": "#/$defs/nullConstantNode"}]},
    "int64OrNullConstantNode": {"oneOf": [{"$ref": "#/$defs/int64ConstantNode"}, {"$ref": "#/$defs/nullConstantNode"}]},
    "stringOrNullConstantNode": {"oneOf": [{"$ref": "#/$defs/stringConstantNode"}, {"$ref": "#/$defs/nullConstantNode"}]},
    "sessionTypedIdConstant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "type", "value"],
      "properties": {
        "kind": {"const": "typedId"},
        "type": {"const": "session"},
        "value": {"type": "string", "maxLength": 4096, "pattern": "^[^\\uD800-\\uDFFF]*$"}
      }
    },
    "windowTypedIdConstant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "type", "value"],
      "properties": {
        "kind": {"const": "typedId"},
        "type": {"const": "window"},
        "value": {"type": "string", "maxLength": 4096, "pattern": "^[^\\uD800-\\uDFFF]*$"}
      }
    },
    "paneTypedIdConstant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "type", "value"],
      "properties": {
        "kind": {"const": "typedId"},
        "type": {"const": "pane"},
        "value": {"type": "string", "maxLength": 4096, "pattern": "^[^\\uD800-\\uDFFF]*$"}
      }
    },
    "clientTypedIdConstant": {
