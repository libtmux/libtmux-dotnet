    "sessionRegex": {
      "allOf": [{"$ref": "#/$defs/regex"}, {"properties": {"input": {"$ref": "#/$defs/sessionField"}}}]
    },
    "windowRegex": {
      "allOf": [{"$ref": "#/$defs/regex"}, {"properties": {"input": {"$ref": "#/$defs/windowField"}}}]
    },
    "paneRegex": {
      "allOf": [{"$ref": "#/$defs/regex"}, {"properties": {"input": {"$ref": "#/$defs/paneField"}}}]
    },
    "clientRegex": {
      "allOf": [{"$ref": "#/$defs/regex"}, {"properties": {"input": {"$ref": "#/$defs/clientField"}}}]
    },
    "sessionQuantifier": {
      "allOf": [{"$ref": "#/$defs/quantifier"}],
