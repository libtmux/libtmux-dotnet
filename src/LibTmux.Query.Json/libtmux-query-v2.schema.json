    "windowIdConstantNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {"kind": {"const": "constant"}, "value": {"$ref": "#/$defs/windowTypedIdConstant"}}
    },
    "paneIdConstantNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {"kind": {"const": "constant"}, "value": {"$ref": "#/$defs/paneTypedIdConstant"}}
    },
    "clientIdConstantNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {"kind": {"const": "constant"}, "value": {"$ref": "#/$defs/clientTypedIdConstant"}}
