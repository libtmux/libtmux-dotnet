        "relation": {"$ref": "#/$defs/collectionRelationField"},
        "predicate": {"$ref": "#/$defs/node"}
      }
    },
    "regex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "input", "dialect", "pattern", "semanticOptions"],
      "properties": {
