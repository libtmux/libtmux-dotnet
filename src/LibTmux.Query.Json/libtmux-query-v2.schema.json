        {
          "allOf": [
            {"$ref": "#/$defs/or"},
            {"properties": {"operands": {"items": {"$ref": "#/$defs/sessionNode"}}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/not"},
            {"properties": {"operand": {"$ref": "#/$defs/sessionNode"}}}
          ]
