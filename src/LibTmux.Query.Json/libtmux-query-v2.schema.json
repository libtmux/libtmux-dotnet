        {
          "title": "client typed ID equality",
          "properties": {
            "operator": {"enum": ["equal", "notEqual"]},
            "left": {"$ref": "#/$defs/clientIdField"},
            "right": {"$ref": "#/$defs/clientIdOrNullConstantNode"}
          }
        }
      ]
    },
