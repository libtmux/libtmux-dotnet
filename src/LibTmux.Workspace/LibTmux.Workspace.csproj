<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>LibTmux.Workspace</AssemblyName>
    <RootNamespace>LibTmux.Workspace</RootNamespace>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>LibTmux.Workspace</PackageId>
    <Description>Builds tmux sessions from tmuxp workspace files, on top of LibTmux.</Description>
    <PackageTags>tmux;tmuxp;workspace;yaml</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- NativeAOT closure has not been proven for this optional dependency. -->
    <IsAotCompatible>false</IsAotCompatible>

    <NoWarn>$(NoWarn);RS0017;RS0026;RS0036</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LibTmux\LibTmux.csproj" />
    <PackageReference Include="YamlDotNet" />
    <InternalsVisibleTo Include="LibTmux.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
