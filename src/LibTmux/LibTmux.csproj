<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>LibTmux</AssemblyName>
    <RootNamespace>LibTmux</RootNamespace>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- RS0016 is the rule worth having: it fails the build when the public
         surface grows without being written down. The other three cannot be
         satisfied while multi-targeting, because each framework reports the
         same record members with its own nullability, so an entry that
         satisfies one is unused by the other. RS0026 objects to the optional
         parameters the reviewed surface is built from. -->
    <NoWarn>$(NoWarn);RS0017;RS0026;RS0036</NoWarn>

    <PackageId>LibTmux</PackageId>
    <Description>A typed, async-first client for the tmux terminal multiplexer. Drive servers, sessions, windows, panes, options, hooks, and buffers from .NET.</Description>
    <PackageTags>tmux;terminal;multiplexer;automation;pty</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- The query interpreter declares its reflective property requirement on
         the public methods that reach it; the rest of the library is static. -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <!-- The package page gets the readme written for the package. The one at
         the repository root is the face of the repository, which is a
         different audience with a different question. -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The analyzer reads these, and they are what makes an unintended change
         to the public surface a build failure rather than a release note. -->
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LibTmux.UnitTests" />
    <InternalsVisibleTo Include="LibTmux.IntegrationTests" />
    <InternalsVisibleTo Include="LibTmux.Mcp" />
    <InternalsVisibleTo Include="LibTmux.Query.Json" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
