<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>LibTmux.Mcp</AssemblyName>
    <RootNamespace>LibTmux.Mcp</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>libtmux-mcp</ToolCommandName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>LibTmux.Mcp</PackageId>
    <Description>A Model Context Protocol server that lets an assistant drive tmux through LibTmux.</Description>
    <PackageTags>tmux;mcp;model-context-protocol;ai</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- A tool package carries its own binaries and their symbols under
         tools/, so a symbols package beside it would hold a second copy of
         what already shipped. -->
    <IncludeSymbols>false</IncludeSymbols>

    <!-- Not trimmed, and the reason is more specific than "it reflects".
         Publishing ahead of time turns off reflective JSON for the whole
         assembly, and the SDK builds each tool's output schema by reflecting
         over its return type, so the process aborts at startup before any tool
         is called. Measured: the AOT publish itself is clean, zero trim
         warnings.

         Reaching it would mean a source-generated context naming every result
         and parameter type, passed through the WithTools overload that takes
         serializer options. That is a list which fails the server at startup
         the first time somebody adds a tool and forgets it, to speed up a
         process an agent starts once per session — and this package ships as
         a framework-dependent tool, which would not use the native build
         anyway. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <Content Include="minimal.conf"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LibTmux\LibTmux.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.Extensions.Tasks" />
    <InternalsVisibleTo Include="LibTmux.IntegrationTests" />
    <InternalsVisibleTo Include="LibTmux.UnitTests" />
  </ItemGroup>
</Project>
