root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true:warning
dotnet_style_require_accessibility_modifiers = always:warning
csharp_style_expression_bodied_methods = when_on_single_line:warning
csharp_style_expression_bodied_constructors = when_on_single_line:warning
csharp_style_expression_bodied_operators = when_on_single_line:warning
csharp_style_expression_bodied_properties = when_on_single_line:warning
csharp_style_expression_bodied_indexers = when_on_single_line:warning
csharp_style_expression_bodied_accessors = when_on_single_line:warning

dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0161.severity = warning
dotnet_diagnostic.IDE0040.severity = warning
dotnet_diagnostic.IDE1005.severity = warning

# Two rules AnalysisLevel 10-recommended leaves off, both about a caller this
# library cannot see: an await resuming on the caller's context deadlocks one
# that blocks, and a token accepted but never forwarded cannot be cancelled.
# `**.cs`, not `**/*.cs`: `**/` wants a directory, missing a project's own root.
[src/**.cs]
dotnet_diagnostic.CA2007.severity = error
dotnet_diagnostic.CA2016.severity = error

# LibTmux.Mcp packs as a tool: its entry point owns the process and has no
# context to return to, as Program.cs says. A later section wins, so this
# opt-out stays below the rule it lifts.
[src/LibTmux.Mcp/**.cs]
dotnet_diagnostic.CA2007.severity = none
