<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>LibTmux.AotSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- This project proves the packages produced by this repository, so it
         must not inherit central versions or a checked-in project graph. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RestoreLockedMode>false</RestoreLockedMode>
    <LibTmuxPackageVersion>$(VersionPrefix)</LibTmuxPackageVersion>
    <LibTmuxPackageVersion Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</LibTmuxPackageVersion>

    <!-- Publishing this ahead of time is the point: the trim and AOT
         analyzers only tell the whole truth when something is actually
         published, and a warning here is a caller's runtime failure. -->
    <PublishAot>true</PublishAot>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibTmux" Version="$(LibTmuxPackageVersion)" />
    <PackageReference Include="LibTmux.Query.Json" Version="$(LibTmuxPackageVersion)" />

    <!-- Real tmux runs here, so this assembly claims a socket root of its own. -->
    <Compile Include="../../eng/dotnet/WorkspaceSocketRoot.cs"
             Link="WorkspaceSocketRoot.cs" />
  </ItemGroup>
</Project>
