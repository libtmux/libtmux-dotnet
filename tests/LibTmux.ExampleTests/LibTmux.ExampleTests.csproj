<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" PrivateAssets="all" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The examples claim the root when they load, which is after the first
         test may already have started; claiming it here comes first. -->
    <Compile Include="../../eng/dotnet/WorkspaceSocketRoot.cs"
             Link="WorkspaceSocketRoot.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The examples are the subject, not a helper: this project runs what the
         documents publish, and reaches LibTmux only through them. -->
    <ProjectReference Include="../../examples/LibTmux.Examples/LibTmux.Examples.csproj" />
  </ItemGroup>
</Project>
