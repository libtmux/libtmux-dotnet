<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>LibTmux.PackageConsumer</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Nothing here references the repository's projects: reaching the
         library through the package is the whole point. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

    <!-- A lock file pins a dependency to exact bytes, which is what it is for
         and what this project cannot have: its one direct dependency is the
         package this repository just built, so the bytes change with every
         commit and a checked-in hash is stale as soon as anything is edited.
         What the graph underneath resolves to is pinned by the library's own
         lock file, which is where it belongs. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RestoreLockedMode>false</RestoreLockedMode>

    <LibTmuxPackageVersion>$(VersionPrefix)</LibTmuxPackageVersion>
    <LibTmuxPackageVersion Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</LibTmuxPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Both references consume the package version this repository builds. -->
    <PackageReference Include="LibTmux" Version="$(LibTmuxPackageVersion)" />
    <PackageReference Include="LibTmux.Query.Json" Version="$(LibTmuxPackageVersion)" />
  </ItemGroup>
</Project>
