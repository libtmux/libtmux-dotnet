<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>LibTmux.PackageConsumer</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Nothing here references the repository's projects: reaching the
         library through the package is the whole point. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

    <!-- A lock file cannot describe this input: the package keeps its version
         while its bytes change with each commit. An isolated cache and source
         mapping ensure the consumer restores the package just built. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RestoreLockedMode>false</RestoreLockedMode>

    <LibTmuxPackageVersion>$(VersionPrefix)</LibTmuxPackageVersion>
    <LibTmuxPackageVersion Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</LibTmuxPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- All references consume the package version this repository builds. -->
    <PackageReference Include="LibTmux" Version="$(LibTmuxPackageVersion)" />
    <PackageReference Include="LibTmux.Query.Json" Version="$(LibTmuxPackageVersion)" />
    <PackageReference Include="LibTmux.Workspace" Version="$(LibTmuxPackageVersion)" />
  </ItemGroup>
</Project>
