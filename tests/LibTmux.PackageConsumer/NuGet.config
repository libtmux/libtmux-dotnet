<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- LibTmux comes from this build; its external dependencies come from the
       public feed they use in a downstream project. -->
  <packageSources>
    <clear />
    <add key="local" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="LibTmux" />
      <package pattern="LibTmux.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
