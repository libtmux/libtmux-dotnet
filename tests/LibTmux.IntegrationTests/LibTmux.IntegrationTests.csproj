<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The documented examples are compiled at test time against the build
         under test, which is what makes a readme something that can fail. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" PrivateAssets="all" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real tmux runs here, so this assembly claims a socket root of its own. -->
    <Compile Include="../../eng/dotnet/WorkspaceSocketRoot.cs"
             Link="WorkspaceSocketRoot.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/LibTmux/LibTmux.csproj" />
    <ProjectReference Include="../../src/LibTmux.Extensions.DependencyInjection/LibTmux.Extensions.DependencyInjection.csproj" />
    <ProjectReference Include="../../src/LibTmux.Testing\LibTmux.Testing.csproj" />
    <ProjectReference Include="../../src/LibTmux.Query.Json/LibTmux.Query.Json.csproj" />
    <ProjectReference Include="../../src/LibTmux.Workspace/LibTmux.Workspace.csproj" />
    <ProjectReference Include="../../src/LibTmux.Mcp/LibTmux.Mcp.csproj" />
    <PackageReference Include="ModelContextProtocol.Extensions.Tasks" />
    <ProjectReference Include="../LibTmux.TestChild/LibTmux.TestChild.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
