<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CS1591;CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Fake executables are written by the helper the integration tests use. -->
    <Compile Include="../LibTmux.IntegrationTests/Infrastructure/TestExecutable.cs"
             Link="Infrastructure/TestExecutable.cs" />
    <Compile Include="../LibTmux.IntegrationTests/Infrastructure/TestBudget.cs"
             Link="Infrastructure/TestBudget.cs" />

    <!-- Some of these tests start a real tmux, so this assembly claims a
         socket root of its own and clears what would reach another server. -->
    <Compile Include="../../eng/dotnet/WorkspaceSocketRoot.cs"
             Link="WorkspaceSocketRoot.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../Fixtures/layouts.json" LogicalName="LibTmux.Tests.Layouts.json" />
    <ProjectReference Include="../../src/LibTmux.Workspace.Cli/LibTmux.Workspace.Cli.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" PrivateAssets="all" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
