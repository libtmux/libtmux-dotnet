# BenchmarkDotNet writes its reports beside the project it ran.
BenchmarkDotNet.Artifacts/

# The engineering scripts under eng/ are Python, run through uv.
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

.DS_Store

# A matrix run stages each lane in a candidate directory beside the
# bundle and promotes it at the end. An interrupted run leaves one, and
# committing it would put a half-recorded lane in the evidence a release
# claims.
docs/parity/evidence/.*.candidate-*
docs/parity/evidence/.*.candidate-*.owner.json

# docfx metadata output, regenerated by libtmux.org's scripts/build-site.sh
_docfx/
