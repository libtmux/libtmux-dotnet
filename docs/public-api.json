    "T:LibTmux.OwnedWindowScope": "owned",
    "T:LibTmux.Pane": "borrowed",
    "T:LibTmux.Server": "borrowed",
    "T:LibTmux.Session": "borrowed",
    "T:LibTmux.Testing.TemporaryHierarchyScope": "owned",
